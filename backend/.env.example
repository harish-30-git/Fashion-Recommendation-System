# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# JWT
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/stylesense?retryWrites=true&w=majority
MONGODB_DB_NAME=stylesense

# Interaction weights (configurable — not experimentally validated)
INTERACTION_WEIGHT_VIEW=0.5
INTERACTION_WEIGHT_WISHLIST=1.5
INTERACTION_WEIGHT_CART=2.0
INTERACTION_WEIGHT_PURCHASE=3.0

# Hybrid recommender weights (must sum to 1.0)
RECOMMENDATION_HYBRID_W1=0.5
RECOMMENDATION_HYBRID_W2=0.3
RECOMMENDATION_HYBRID_W3=0.2
